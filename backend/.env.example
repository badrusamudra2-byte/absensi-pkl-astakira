NODE_ENV=development
PORT=4000
TZ_APLIKASI=Asia/Jakarta
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=absensi_pkl
DB_USER=root
DB_PASS=
# true hanya untuk development awal (membuat tabel otomatis). Produksi: pakai migrasi.
DB_SYNC=true

# Minimal 32 karakter acak
JWT_SECRET=
JWT_EXPIRES=8h

# 64 karakter hex. Buat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FACE_KEY=
FACE_THRESHOLD=0.5
FACE_DIM=128
FACE_VERIFY_TTL_DETIK=180

QR_TTL_DETIK=30
SCAN_KONFIRMASI_DETIK=120


# Pisahkan dengan koma jika lebih dari satu
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Kosongkan SMTP_HOST di development: email hanya dicetak ke konsol
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Astakira Media <no-reply@astakira.id>"

# Dipakai oleh npm run seed
SEED_PASSWORD=

# Job penutup hari: selisih menit setelah jam pulang untuk menandai Tidak hadir
TUTUP_HARI_MENIT=60

# Produksi: backend menyajikan build frontend/dist dari origin yang sama (CSP penuh).
# Jalankan "npm run build" di frontend/ terlebih dulu.
SERVE_FRONTEND=false
