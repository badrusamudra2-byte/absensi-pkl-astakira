{
  "name": "absensi-pkl-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API Panel Absensi PKL dan Jurnal Kegiatan - Astakira Media",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "tutup-hari": "node scripts/tutup-hari.js",
    "db:migrate": "sequelize-cli db:migrate",
