    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^10.1.2",
    "pdfkit": "^0.20.2",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
