{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: jalankan API",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/src/server.js",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Backend: seed data awal",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/scripts/seed.js",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env"
    }
  ]
}
